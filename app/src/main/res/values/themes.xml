<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeyBase" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Invisible host for the fingerprint prompt shown over another app during autofill. -->
    <style name="Theme.KeyBase.Translucent" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <color name="window_bg">#F5F5F7</color>
    <color name="ic_launcher_background">#000000</color>
</resources>
